# ==============================================================================
# INTELLMEET - ENVIRONMENT VARIABLES CONFIGURATION (.env)
# ==============================================================================

# General
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database
# Connects to external MongoDB daemon or MongoDB Atlas.
# In development, if unreachable, IntellMeet automatically spins up an in-memory database fallback!
MONGODB_URI=mongodb://127.0.0.1:27017/intellmeet

# Authentication & Security
# Generate secure 64-character random strings in production
JWT_ACCESS_SECRET=intellmeet-development-jwt-access-secret-key-32chars!
JWT_REFRESH_SECRET=intellmeet-development-jwt-refresh-secret-key-32chars!
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_SECRET=intellmeet-development-cookie-secret-key-32chars!

# AI Intelligence Provider
# Options: 'mock' (default, offline, zero-cost, high-fidelity), 'groq', or 'openai'
AI_PROVIDER=groq
# Groq API configuration (ultra-fast inference)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Required only if AI_PROVIDER=openai
OPENAI_API_KEY=

# Optional Caching & Multi-instance Socket Coordination
REDIS_URL=

# WebRTC STUN/TURN Signaling
# Public Google STUN servers work out-of-the-box for standard NAT networks
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Optional TURN server for symmetric corporate firewalls (e.g. coturn)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
